# Copy this file to .env. Keep .env private; it is never included in project exports.
# Local editing works without any AI configuration.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Explicit opt-in required before any external model request.
TRANSLATION_ALLOW_PAID=false
TRANSLATION_BATCH_SIZE=8
TRANSLATION_MAX_OUTPUT_TOKENS=4096
# Optional absolute data directory. Default: this project's .workbench-data/.
# SUBTITLE_DATA_DIR=
